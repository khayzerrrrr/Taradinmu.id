// Skema database TaradinMu (sumber: TARADINMU-PRD.md Bagian 3)
// Catatan: blok generator & datasource disesuaikan dengan konvensi Prisma 7.
// - generator memakai provider "prisma-client" dengan output wajib.
// - datasource tidak lagi memuat `url`; DATABASE_URL dibaca dari prisma7.config.ts.
// Catatan: model InvoiceItem ditambahkan agar invoice bisa menautkan varian
// (dibutuhkan untuk memotong stok InventoryBatch). Sudah dicerminkan di PRD.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN // Khusus Pak Reza (Platform Owner)
  OWNER       // Pemilik Tenant/Toko
  ADMIN
  STAFF
  ACCOUNTANT
}

enum PlanType {
  FREE // Default: Pakai path /nama-toko, logo default, modul dasar
  PRO  // Berbayar: Subdomain toko.taradinmu.id, custom logo/warna, semua modul
}

// Jenis usaha tenant — menentukan perilaku modul (mis. batch/expired untuk
// RETAIL_FNB & HEALTH_CLINIC). Nilai di sini mengikuti PRD Bagian 4.C.
enum BusinessType {
  RETAIL_FNB    // Minimarket, Catering, F&B
  TRAVEL_UMROH  // Travel Umrah & Haji
  JASA_ORDER    // Laundry, Aqiqah, Konveksi
  PROJECT_BASED // Kontraktor, Event Organizer
  TRADING       // Ekspor-Impor, Distributor
  EDUCATION     // Sekolah, Bimbel, Pesantren
  HEALTH_CLINIC // Klinik, Apotek, Layanan Kesehatan
  OTHER         // Lainnya
}

enum ExpenseCategory {
  OPERATIONAL // Operasional harian
  PURCHASE    // Pembelian stok/barang
  SALARY      // Gaji & upah
  RENT        // Sewa tempat
  UTILITIES   // Listrik, air, internet
  MARKETING   // Pemasaran & promosi
  TAX         // Pajak & retribusi
  OTHER       // Lainnya
}

// Jenis zakat yang bisa dihitung tenant (PRD: modul Zakat).
enum ZakatType {
  TRADE       // Zakat perdagangan (tijarah)
  SAVINGS     // Zakat simpanan/uang
  GOLD        // Zakat emas & perak
  INCOME      // Zakat penghasilan
  AGRICULTURE // Zakat pertanian
  LIVESTOCK   // Zakat peternakan
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

// Sifat item katalog. Disimpan EKSPLISIT, tidak disimpulkan dari "punya batch
// atau tidak": barang yang stoknya sedang kosong akan keliru dianggap jasa,
// lalu invoice berhenti memotong stok tanpa ada yang menyadari.
enum ItemKind {
  GOODS   // Barang: punya stok/batch; invoice memotong stok (FEFO)
  SERVICE // Jasa: tanpa stok; invoice tidak menyentuh stok
}

// Siklus hidup Program (PRD 4.F). Status hanya menyaring daftar — ia tidak
// mengubah angka terkumpul/terpakai, karena angka itu berasal dari invoice dan
// pengeluaran yang ditautkan, bukan dari status.
enum ProgramStatus {
  PLANNING  // Direncanakan
  ACTIVE    // Berjalan
  COMPLETED // Selesai
  CANCELLED // Dibatalkan (bisa dari status mana pun)
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalSource {
  INVOICE
  PAYMENT
  STOCK
  EXPENSE
  MANUAL
  OPENING
  REVERSAL
  CLOSING
}

enum PeriodStatus {
  OPEN
  CLOSED
}

/// Sisi jurnal. DEBIT menambah aset dan beban; KREDIT menambah liabilitas,
/// ekuitas, dan pendapatan.
enum PostingSide {
  DEBIT
  CREDIT
}

model Tenant {
  id              String   @id @default(cuid())
  name            String // Nama Usaha (e.g., "Klinik Sehat Muhammadiyah")
  slug            String   @unique // Untuk path URL (e.g., "klinik-sehat")
  subdomain       String?  @unique // Untuk subdomain (e.g., "klinik-sehat" -> klinik-sehat.taradinmu.id)

  plan            PlanType @default(FREE)
  /// Batas masa berlaku paket PRO (PRD 4.D.4). null = tanpa tanggal berakhir:
  /// dipakai FREE, dan oleh PRO lama yang masanya belum dicatat Super Admin.
  /// Setelah tanggal ini lewat, tenant berjalan sebagai FREE tanpa datanya
  /// dihapus — dilihat dari `planEfektif()`, bukan dari kolom `plan`.
  planExpiresAt   DateTime?

  // --- Identitas lokalitas usaha (Fase 0.2, PRD §3 "Regulatory per negara") ---
  //
  // Dua kolom ini ada karena produk dit diarahkan ke luar Indonesia, dan
  // keduanya tidak bisa ditebak kemudian tanpa mengubah data yang sudah ada.
  //
  // `currency` menentukan presisi & format nominal. Semua kolom uang widened ke
  // Decimal(18,4) pada fase yang sama: IDR tidak butuh desimal, USD/Euro butuh
  // dua, dan tuple beberapa pasar Timur Tengah bisa butuh tiga — Decimal(12,2)
  // hanya menyisakan 10 digit bulat, sedangkan akumulasi nominal dalam satu
  // tenant bisa melampauinya.
  //
  // `timezone` menentukan "hari" untuk seluruh perhitungan bisnis. Nilai ini
  // bukan装饰: calculating "sisa N hari" dari hari UTC membuat penyewa di WIB
  // membaca satu hari terlalu banyak setiap pagi (terbukti di fase AE).
  //@Column(Char(3)) karena ISO 4217 selalu tiga huruf — VARCHAR, bukan integer.
  currency        String   @default("IDR") @db.Char(3)
  /// IANA timezone, mis. "Asia/Jakarta". Bukan offset: zona punya aturan DST,
  /// sehingga offset yang disimpan akan salah setiap kali negara mengubahnya.
  timezone        String   @default("Asia/Jakarta")

  businessType    BusinessType @default(OTHER) // Jenis usaha (PRD: menentukan perilaku modul)
  enabledModules  String[] // Array modul aktif: ["INVENTORY", "BILLING"]
  categories      String[] // Kategori default dari preset jenis usaha (diisi saat registrasi)

  // Custom Branding (White-label)
  customLogoUrl   String? // URL logo custom tenant
  primaryColor    String?  @default("#059669") // Warna utama custom
  dashboardLayout String? // JSON config untuk layout dashboard

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  products        Product[]
  suppliers       Supplier[]
  customers       Customer[]
  invoices        Invoice[]
  expenses        Expense[]
  zakatCalculations ZakatCalculation[]
  programs          Program[]
  upgradeInterests  UpgradeInterest[]
  planChanges       PlanChange[]
  ledgerAccounts    LedgerAccount[]
  journalEntries    JournalEntry[]
  accountingPeriods AccountingPeriod[]
}

model User {
  id            String    @id @default(cuid())
  tenantId      String? // Null jika SUPER_ADMIN
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
  name          String
  email         String    @unique
  emailVerified DateTime? // Dipakai Auth.js (adapter) untuk verifikasi email
  image         String? // Foto profil dari provider OAuth
  password      String
  role          Role      @default(STAFF)
  accounts      Account[]
  sessions      Session[]
  /// Riwayat paket yang diubah akun ini (hanya Super Admin yang punya aksi itu).
  planChanges   PlanChange[]
  createdAt     DateTime  @default(now())
}

// --- AUTH.JS (NextAuth v5) — model wajib untuk @auth/prisma-adapter ---
// Sesi aplikasi tetap JWT (lihat auth.config.ts); tabel Session disediakan
// agar adapter berfungsi penuh bila kelak menambah provider OAuth.

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// --- MODUL INVENTORY ---
model Product {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String // e.g., "Paracetamol", "Baju Koko", atau "Paket Umrah 9 hari"
  description String?
  // Barang atau jasa (PRD 4.C: travel, laundry, dan pendidikan menjual jasa).
  kind        ItemKind @default(GOODS)
  variants    ProductVariant[]
  createdAt   DateTime @default(now())

  // Dipakai untuk memutuskan apakah menu Stok perlu ditampilkan pada tenant ini.
  @@index([tenantId, kind])
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku          String   @unique
  name         String // e.g., "Paracetamol 500mg" atau "Baju Koko - L - Putih"
  price        Decimal  @db.Decimal(18, 4)
  batches      InventoryBatch[]
  invoiceItems InvoiceItem[]
}

// Pemasok (PRD 4.G.4): master data tempat barang dibeli.
// Entitas sungguhan, bukan kolom teks di form stok — pertanyaan "modal siapa yang
// masih numpuk di pemasok ini" tidak bisa dijawab oleh teks bebas yang beda ejaan
// tiap kali diisi.
model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?

  batches   InventoryBatch[]
  createdAt DateTime @default(now())

  // Daftar pemasok adalah tampilan utamanya; nama tidak unik dalam tenant karena
  // dua cabang boleh punya pemasok dengan nama sama, dan menolaknya hanya
  // menghasilkan kebingungan tanpa memperbaiki angka apa pun.
  @@index([tenantId])
}

model InventoryBatch {
  id             String   @id @default(cuid())
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  batchNumber    String // e.g., "BATCH-2024-001"
  quantity       Int // Stok saat ini di batch ini
  expiredDate    DateTime? // Wajib untuk F&B dan Farmasi
  // Harga modal per unit saat batch ini masuk (PRD 4.G.2). Berada di batch, bukan
  // di varian, karena harga beli berubah antar waktu — satu harga di varian akan
  // membuat HPP bulan lalu ikut berubah setelah pembelian berikutnya.
  // Nullable SENGAJA: batch lama tidak punya catatan harga modal, dan memaksa 0
  // menghasilkan laba yang membengkak palsu — lebih jujur ditulis "belum tahu".
  costPrice      Decimal? @db.Decimal(18, 4)
  // Penghapusan pemasok tidak boleh menghapus batch: SetNull, sama seperti
  // aturan programId pada Invoice/Expense (PRD 4.F.9).
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  movements      StockMovement[]

  @@index([supplierId])
}

model StockMovement {
  id          String   @id @default(cuid())
  batchId     String
  batch       InventoryBatch @relation(fields: [batchId], references: [id])
  type        StockMovementType
  quantity    Int
  // Salinan costPrice batch pada saat potongan terjadi (PRD 4.G.3): dasar HPP.
  // Potret sesaat, bukan view turunan — koreksi costPrice belakangan tidak boleh
  // mengubah HPP yang sudah tercatat.
  unitCost    Decimal? @db.Decimal(18, 4)
  reference   String? // e.g., "INV-001" atau "PO-002"
  notes       String?
  createdAt   DateTime @default(now())

  // HPP per dokumen (PRD 4.G.3) dan pengembalian stok sama-sama menyaring pada
  // dua kolom ini; tanpa index keduanya menjadi pemindaian penuh tabel movement.
  @@index([type, reference])
}

// --- MODUL BILLING ---
model Customer {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  phone       String?
  email       String?
  address     String?
  invoices    Invoice[]
  // Keikutsertaan pada program (PRD 4.F). Peserta memakai Customer yang sudah
  // ada — sengaja tidak dibuat model Jamaah/Siswa sendiri.
  programParticipations ProgramParticipant[]
  createdAt   DateTime @default(now())
}

model Invoice {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  invoiceNumber String   @unique
  totalAmount   Decimal  @db.Decimal(18, 4)
  taxAmount     Decimal  @db.Decimal(18, 4) @default(0)
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime
  paidAt        DateTime? // diisi saat status menjadi PAID (dasar pendapatan)
  notes         String?
  // Label program (PRD 4.F). Nullable: invoice biasa tetap ada seperti sebelum
  // modul ini ada, dan menghapus program melepas tautannya tanpa menghapus uang.
  programId     String?
  program       Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  items         InvoiceItem[]
  createdAt     DateTime @default(now())

  // Kuota FREE dihitung per bulan (PRD 4.D): `createdAt >= awal bulan`.
  // Tanpa index ini setiap pemeriksaan kuota menjadi pemindaian penuh.
  @@index([tenantId, createdAt])
  // Roll-up "terkumpul" per program menyaring pada kolom ini.
  @@index([programId])
}

// Baris item invoice: menautkan invoice ke varian (dasar pemotongan stok).
model InvoiceItem {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  price     Decimal  @db.Decimal(18, 4) // harga satuan saat invoice dibuat
  subtotal  Decimal  @db.Decimal(18, 4)
}

// --- MODUL AKUNTANSI ---
model Expense {
  id            String          @id @default(cuid())
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category      ExpenseCategory @default(OTHER)
  description   String // Keterangan pengeluaran
  amount        Decimal         @db.Decimal(18, 4)
  expenseDate   DateTime        @default(now())
  paymentMethod String? // e.g., "CASH", "TRANSFER"
  reference     String? // Nota/bukti terkait
  notes         String?
  // Label program (PRD 4.F); dasar "terpakai" pada ringkasan program.
  programId     String?
  program       Program?        @relation(fields: [programId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([tenantId, expenseDate])
  @@index([programId])
}

// --- MODUL PROGRAM (PRD 4.F) ---
//
// Satu mesin untuk kebutuhan yang dulu tertulis sebagai tiga modul industri
// berbeda: "CRM Data Jamaah" (travel), "Billing per Proyek" (kontraktor/EO), dan
// penagihan per tahun ajaran (pendidikan). Ketiganya objek yang sama: sekumpulan
// orang, satu rentang waktu, target dana masuk, anggaran keluar.
model Program {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  startDate    DateTime
  // Boleh kosong selama program masih berjalan (PRD 4.F.1).
  endDate      DateTime?
  status       ProgramStatus @default(PLANNING)
  // Target dana masuk dan anggaran keluar, keduanya opsional: travel umrah
  // peduli pada target dana, kontraktor pada anggaran. Memaksa dua-duanya
  // hanya menghasilkan kolom kosong yang diisi asal.
  targetAmount Decimal?      @db.Decimal(18, 4)
  budgetAmount Decimal?      @db.Decimal(18, 4)

  participants ProgramParticipant[]
  invoices     Invoice[]
  expenses     Expense[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Daftar program aktif per tenant adalah tampilan utamanya.
  @@index([tenantId, status])
}

// Peserta program. Tabel perantara murni: identitas peserta tetap milik Customer.
model ProgramParticipant {
  id         String   @id @default(cuid())
  programId  String
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  joinedAt   DateTime @default(now())
  notes      String?

  // Satu orang tidak boleh terdaftar dua kali pada program yang sama.
  @@unique([programId, customerId])
  @@index([customerId])
}

// --- MODUL ZAKAT ---
model ZakatCalculation {
  id                 String    @id @default(cuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type               ZakatType @default(TRADE)
  calculationDate    DateTime  @default(now())
  // Periode laporan zakat (PRD 4.D.3), mis. 9/2026. Selalu diisi server dari
  // bulan berjalan — bukan disalin dari waktu input — supaya riwayat bisa
  // dikelompokkan dan dicetak per bulan. Nullable demi baris lama sebelum migrasi.
  periodMonth        Int?
  periodYear         Int?
  totalAssets        Decimal   @db.Decimal(18, 4) // Total harta/aset usaha
  totalLiabilities   Decimal   @db.Decimal(18, 4) @default(0) // Hutang/kewajiban
  netAssets          Decimal   @db.Decimal(18, 4) // Harta bersih (dasar zakat)
  nisab              Decimal   @db.Decimal(18, 4) // Batas nisab saat perhitungan
  rate               Decimal   @db.Decimal(5, 4) @default(0.025) // Kadar zakat (2,5%)
  zakatDue           Decimal   @db.Decimal(18, 4) // Zakat terutang (0 bila di bawah nisab)
  isPaid             Boolean   @default(false)
  paidAt             DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([tenantId, calculationDate])
  // Pengelompokan & pengurutan riwayat per periode laporan (PRD 4.D.3).
  @@index([tenantId, periodYear, periodMonth])
}

// --- PENGERASAN PRODUKSI ---

// Penghitung rate limit "fixed window" untuk menahan percobaan berulang
// (brute force login, penyalahgunaan /api/chat).
//
// Disimpan di database, bukan di memori proses: produksi berjalan di beberapa
// instance tanpa state bersama, sehingga limiter in-memory bisa dilewati cukup
// dengan berpindah instance. Baris lama dibersihkan berkala oleh
// src/lib/rate-limit.ts (tidak ada penjadwal di proyek ini).
model RateLimit {
  id          String   @id @default(cuid())
  key         String // mis. "login:<email>" atau "chat:<userId>"
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([key, windowStart])
  @@index([windowStart])
}

// Catatan "gembok mana yang diklik" (PRD 4.D.5).
//
// Alasan tabel ini ada: urutan pengerjaan fitur PRO selama ini dipilih dari
// perasaan. Yang sebenarnya terjadi di produksi tidak terukur — sebuah gembok
// bisa saja diklik dua puluh kali minggu ini tanpa pernah tercatat di mana pun.
// Dua peristiwa yang disimpan terpisah karena keduanya menjawab pertanyaan
// berbeda: `tahap = BUKA` (gembok mana yang menahan orang) dan `tahap = CTA`
// (ajakan mana yang benar-benar dibaca sampai tombol WhatsApp).
//
// Sengaja TIDAK menyimpan teks bebas maupun data usaha: hanya kunci fitur,
// lokasi pemicu dari daftar statis, dan tahap. Tabel ini karena itu tidak boleh
// dipakai untuk menyimpan apa pun yang berasal dari ketikan pengguna.
model UpgradeInterest {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Salah satu KUNCI_MINAT di src/lib/upgrade-interest.ts (BATCH, ZAKAT, ..., UMUM).
  kunci     String
  /// Komponen/halaman pemicu, dari daftar statis di kode — bukan input pengguna.
  sumber    String
  /// "BUKA" (modal terbuka) atau "CTA" (menuju WhatsApp diklik).
  tahap     String
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([kunci, createdAt])
}

/// Riwayat perubahan paket langganan (PRD 4.D.4).
///
/// Alasan tabel ini ada: aktivasi PRO dilakukan manual lewat WhatsApp, dan sampai
/// sekarang tidak ada tempat untuk menjawab "sejak kapan toko ini PRO, atas nama
/// pembayaran yang mana, dan siapa yang mengaktifkannya". Tanpa itu, menagih
/// perpanjangan bulan berikutnya berarti menebak dari log obrolan.
///
/// Ditulis setiap kali `plan` berubah — bukan hanya saat naik ke PRO, supaya
/// penurunan karena tempo juga meninggalkan jejak. Barisnya tidak pernah
/// di-update: riwayat yang bisa diedit bukan riwayat.
model PlanChange {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dari     PlanType
  ke       PlanType
  /// Nilai planExpiresAt sesudah perubahan ini, agar baris riwayat bisa dibaca
  /// tanpa perlu menggali tanggal per tanggal dari kolom tenant.
  expiresAt DateTime?
  /// Akun Super Admin yang melakukan perubahan. null = belum tercatat (baris
  /// hasil impor/manual di awal) atau akun pengubah sudah dihapus.
  olehUserId String?
  oleh       User?    @relation(fields: [olehUserId], references: [id], onDelete: SetNull)
  /// Catatan operator, mis. nomor transaksi. Dipangkas & dibatasi panjangnya di
  /// `updateTenantPlanAndModules`, dan hanya Super Admin yang bisa menulisnya.
  catatan    String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}

// --- MODUL AKUNTANSI: GL (Fase 1) ---
//
// Empat tabel di bawah adalah sumber kebenaran pembukuan. Setelah fase ini,
// angka dashboard WAJIB dibaca dari sini, bukan dari agregat Expense/Invoice �
// dua sumber kebenaran angka adalah cara paling pasti menghasilkan laporan yang
// berbeda sendiri.
//
// Namanya `LedgerAccount`, bukan `Account`, karena `Account` sudah dipakai
// NextAuth untuk OAuth di skema ini.

// Chart of Accounts.
//
// `type` berupa enum tertutup, bukan string bebas: laporan mengelompokkan akun
// ke dalam ASET/LIABILITAS/EKUITAS/PENDAPATAN/BEBAN, dan pengelompokan itu
// hanya stabil selama daftar tipenya tidak bertambah diam-diam.
//
// `code` unik per tenant, bukan global: dua tenant boleh memakai kode "1-1001"
// untuk akun yang berbeda karena masing-masing punya CoA-nya sendiri.
model LedgerAccount {
  id         String      @id @default(cuid())
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Kode akun, mis. "1-1001". Unik dalam tenant.
  code       String
  name       String
  type       AccountType
  /// ISO 4217. Posting memakai mata uang akun; jurnal harus seimbang per
  /// mata uang, jadi akun mata uang asing tidak boleh ikut dalam jurnal IDR.
  currency   String      @default("IDR") @db.Char(3)
  /// Induk untuk laporan berkelompok. Nullable karena akun Synthetic (mis.
  /// total beban) tidak punya induk.
  parentId   String?
  parent     LedgerAccount?  @relation("AccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   LedgerAccount[] @relation("AccountTree")
  /// Akun sistem tidak boleh dihapus atau dinonaktifkan: laporan memfiksilkan
  /// kodenya, dan menghilangkannya membuat laporan bulan lalu tidak bisa
  /// ditelusuri kembali.
  isActive   Boolean     @default(true)
  isSystem   Boolean     @default(false)
  createdAt  DateTime    @default(now())

  postings   Posting[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
}

/// Satu transaksi pembukuan. Append-only.
///
/// `businessDate` adalah tanggal AKUNTANSI � tanggal masa transaksi terjadi,
/// bukan tanggal baris ini dibuat. Inilah yang membuat buku besar bisa dibaca
/// ulang tanpa annoying dari tanggal input.
model JournalEntry {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessDate DateTime
  /// "YYYY-MM" � periode tempat jurnal ini dihitung. Disalin dari businessDate
  /// supaya query laporan per periode tidak perlu timezone-aware di database.
  period       String
  postedAt     DateTime?
  source       JournalSource
  /// Nomor dokumen sumber (nomor invoice, "BATCH-001", dll).
  reference    String?
  refType      String?
  refId        String?
  description  String?
  currency     String        @default("IDR") @db.Char(3)
  /// Jurnal ini adalah pembalik dari jurnal mana. Scalar murni, BUKAN relation.
  ///
  /// Semula ditulis sebagai self-relation dua arah (reversedBy + reversedFrom),
  /// lalu terbukti tidak bisa: Prisma hanya membuat SATU kolom FK untuk
  /// self-relation satu-arah, sehingga `reversedFromId` tidak pernah ada di
  /// database dan trigger pembatalan gagal saat dijalankan di PostgreSQL asli.
  /// ColumnNotFound: record "new" has no field "reversedFromId".
  ///
  /// Scalar murni dipilih karena hanya satu sisi yang perlu disimpan: siapa yang
  /// membatalkan siapa dapat dijawab dengan `reversedFromId` saja. Dua kolom
  /// (reversedById DAN reversedFromId) berarti dua sumber kebenaran untuk fakta
  /// yang sama — jenis kesalahan yang paling sering menghasilkan pembukuan yang
  /// berbeda dengan dirinya sendiri.
  ///
  /// UNIQUE di bawah yang mencegah satu jurnal dibatalkan dua kali; trigger di
  /// migrasi hanya mengulang aturan itu dengan pesan yang bisa dibaca aplikasi.
  reversedFromId String?      @unique
  createdById  String?
  createdAt    DateTime      @default(now())

  postings     Posting[]

  @@index([tenantId, businessDate])
  @@index([tenantId, period])
  @@index([refType, refId])
}

/// Satu baris jurnal: akun + nominal sisi debit atau kredit.
///
/// WAJIB append-only: tidak ada UPDATE, tidak ada DELETE. Koreksi dilakukan lewat
/// jurnal pembalik (reversal), bukan dengan mengubah angka yang sudah
/// dipublikasikan ke pengguna. Mengubah sejarah alih-alih menambahkannya
/// membuat pembukuan berhenti menjadi bukti.
///
/// `amount` disimpan sebagai SATU kolom dengan sisi di `side`, bukan dua kolom
/// debit dan credit terpisah: dua kolom memaksa setiap pembaca menambahkan
/// kalimat "yang mana yang nonzero", dan menyisakan ruang untuk baris yang
/// terisi keduanya. Sisi yang eksplisit membuat CHECK di database sederhana
/// dan tidak ambigu saat dibaca.
model Posting {
  id        String        @id @default(cuid())
  journalId String
  journal   JournalEntry  @relation(fields: [journalId], references: [id], onDelete: Restrict)
  accountId String
  account   LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  /// Nilai positif. SISI DEBIT atau KREDIT ada di `side`.
  amount    Decimal       @db.Decimal(18, 4)
  side      PostingSide
  currency  String        @default("IDR") @db.Char(3)
  createdAt DateTime      @default(now())

  @@index([journalId])
  @@index([accountId])
  /// Satu akun satu kali per jurnal: mencegah baris dobel yang tidak terlihat
  /// saat membaca buku besar.
  @@unique([journalId, accountId])
}

/// Periode akuntansi. CLOSED berarti tidak ada posting baru yang boleh masuk.
model AccountingPeriod {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// "YYYY-MM"
  period    String
  status    PeriodStatus @default(OPEN)
  closedAt  DateTime?
  closedById String?
  createdAt DateTime     @default(now())

  @@unique([tenantId, period])
}
